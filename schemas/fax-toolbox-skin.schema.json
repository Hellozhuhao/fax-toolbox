{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fax Toolbox skin v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "appearance",
    "targets",
    "tokens"
  ],
  "properties": {
    "format": {
      "const": "fax-toolbox.skin"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "appearance": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^(\\*|[a-z][a-z0-9.-]{0,79})$"
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "panel",
        "surface",
        "text",
        "muted",
        "accent",
        "border",
        "navigation",
        "radius"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "panel": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "navigation": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "enum": [
            "left",
            "top",
            "right"
          ]
        },
        "density": {
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "motion": {
          "enum": [
            "system",
            "reduced"
          ]
        }
      }
    },
    "css": {
      "type": "string",
      "maxLength": 131072
    },
    "bindings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "selector",
          "action"
        ],
        "properties": {
          "event": {
            "enum": [
              "click",
              "keydown"
            ]
          },
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "args": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "event": {
                  "const": "keydown"
                }
              }
            },
            "then": {
              "required": [
                "key"
              ]
            }
          }
        ]
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "html",
        "script",
        "actions"
      ],
      "properties": {
        "mode": {
          "enum": [
            "replace",
            "append"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "html": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        },
        "css": {
          "type": "string",
          "maxLength": 131072
        },
        "script": {
          "type": "string",
          "maxLength": 131072
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,99}$"
          }
        }
      }
    }
  }
}
