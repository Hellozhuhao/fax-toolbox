<Application x:Class="FaxToolbox.Setup.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#273448" />
    <SolidColorBrush x:Key="Muted" Color="#767C86" />
    <SolidColorBrush x:Key="Accent" Color="#D66B49" />
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand" /><Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="18,0" /><Setter Property="Background" Value="#D66B49" />
      <Setter Property="Foreground" Value="White" /><Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#ECEAE6" /><Setter Property="Foreground" Value="#273448" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="FontSize" Value="13" /></Style>
  </Application.Resources>
</Application>
