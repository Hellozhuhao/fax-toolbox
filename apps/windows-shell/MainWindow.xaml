<Window x:Class="FaxToolbox.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Fax Toolbox" Width="1180" Height="760" MinWidth="840" MinHeight="540"
        Background="#10151F" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <wv2:WebView2 x:Name="ShellView" Grid.Column="0" />
        <wv2:WebView2 x:Name="ModuleView" Grid.Column="1" />
        <wv2:WebView2 x:Name="CourseView" Grid.Column="1" Visibility="Collapsed" />
    </Grid>
</Window>
