<Window x:Class="FaxToolbox.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Fax Toolbox · Beta 版" Width="1280" Height="800" MinWidth="780" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Ui.Background}" FontFamily="{DynamicResource Ui.Font}"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Ui.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/><Setter Property="Padding" Value="12,6"/></Style>
        <Style x:Key="TaskTabButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,5"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="TaskTabInnerStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
        <Style x:Key="TaskTabCloseStyle" TargetType="Button" BasedOn="{StaticResource TaskTabInnerStyle}"><Setter Property="FontSize" Value="18"/></Style>
        <Style x:Key="TitleActionStyle" TargetType="Button" BasedOn="{StaticResource TaskTabInnerStyle}"><Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/><Setter Property="FontSize" Value="17"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Ui.Surface}"/></Trigger></Style.Triggers></Style>
        <Style x:Key="TitleCloseStyle" TargetType="Button" BasedOn="{StaticResource TitleActionStyle}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B32939"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
        <Style x:Key="EmbeddedContextItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition x:Name="ToolbarRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellColumn" Width="*" />
            <ColumnDefinition x:Name="SplitterColumn" Width="0" />
            <ColumnDefinition x:Name="WorkspaceColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource Ui.Background}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="pack://application:,,,/assets/fax-toolbox.png" Width="26" Height="26"
                       VerticalAlignment="Center" />
                <TextBlock x:Name="TitleName" Text="Fax Toolbox" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ui.Text}"/>
                <Border Height="17" Width="1" Background="{DynamicResource Ui.Border}" Margin="11,0,10,0" />
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Ui.Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleStatus" Text="准备中" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Ui.Muted}"/>
                <Border x:Name="DeveloperBadge" Visibility="Collapsed" Margin="12,0,0,0" Padding="9,3"
                        VerticalAlignment="Center" CornerRadius="9" Background="#ECE3FF" BorderBrush="#C7B4F3" BorderThickness="1">
                    <TextBlock x:Name="DeveloperBadgeText" Text="开发者模式" Foreground="#6844B3" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Width="45" Height="44" Content="−" ToolTip="最小化" Style="{StaticResource TitleActionStyle}" Click="TitleMinimize_Click"/>
                <Button x:Name="TitleMaximizeButton" Width="45" Height="44" Content="□" ToolTip="最大化或还原" Style="{StaticResource TitleActionStyle}" Click="TitleMaximize_Click"/>
                <Button Width="48" Height="44" Content="×" FontSize="20" ToolTip="关闭工具箱" Style="{StaticResource TitleCloseStyle}" Click="TitleClose_Click"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="BrowserToolbar" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed"
              Background="{DynamicResource Ui.Background}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,0,4">
                <Button x:Name="BrowserBackButton" Width="40" Height="40" Margin="0,0,6,0" Padding="0"
                        Style="{StaticResource TaskTabButtonStyle}" Click="BrowserBack_Click"
                        AutomationProperties.Name="返回上一页" ToolTip="返回上一页，优先返回当前网页；Shift+点击返回工具箱上一页" Content="←" IsEnabled="False" />
                <Button x:Name="BrowserReloadButton" Width="40" Height="40" Margin="0,0,8,0" Padding="0"
                        Style="{StaticResource TaskTabButtonStyle}" Click="BrowserReload_Click"
                        AutomationProperties.Name="刷新当前页面" ToolTip="刷新当前页面" Content="↻" />
            </StackPanel>
            <ScrollViewer x:Name="TaskTabsScroller" Grid.Column="1" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="HorizontalOnly"
                          PreviewMouseWheel="TaskTabs_MouseWheel" AutomationProperties.Name="工作标签">
                <StackPanel x:Name="TaskTabsPanel" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue"/>
            </ScrollViewer>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4,8,4">
                <Button x:Name="NewTaskTabButton" Width="40" Height="40" Padding="0" Style="{StaticResource TaskTabButtonStyle}"
                        Click="NewTaskTab_Click" AutomationProperties.Name="新建首页标签" ToolTip="新建首页标签" Content="＋" />
                <Button x:Name="ToggleControlsButton" Width="40" Height="40" Margin="6,0,0,0" Padding="0"
                        Style="{StaticResource TaskTabButtonStyle}" Click="ToggleControls_Click" Content="⇤" AutomationProperties.Name="切换控制面板" ToolTip="收起控制面板" />
            </StackPanel>
            <TextBlock x:Name="ToolbarTitle" Visibility="Collapsed" Foreground="{DynamicResource Ui.Muted}"
                       ToolTip="关闭标签将结束该标签的任务" />
        </Grid>
        <wv2:WebView2 x:Name="ShellView" Grid.Row="2" Grid.Column="0" Visibility="Collapsed" />
        <GridSplitter x:Name="WorkspaceSplitter" Grid.Row="2" Grid.Column="1" Width="6" Cursor="SizeWE"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DEDAD5"
                      ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />
        <wv2:WebView2 x:Name="ModuleView" Grid.Row="2" Grid.Column="2" />
        <wv2:WebView2 x:Name="CourseView" Grid.Row="2" Grid.Column="2" Visibility="Collapsed" />
        <Border x:Name="TaskLoadingSurface" Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource Ui.Background}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TaskLoadingTitle" Text="Fax 工具箱" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="TaskLoadingDetail" Text="正在打开工作区" FontSize="13" Foreground="{DynamicResource Ui.Muted}" Margin="0,9,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border x:Name="CourseOverlay" Grid.Row="2" Grid.Column="2" Visibility="Collapsed"
                Background="{DynamicResource Ui.Background}" Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock x:Name="CourseOverlayTitle" Text="正在打开学习通…" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ui.Text}" Margin="0,0,0,12" />
                <TextBlock x:Name="CourseOverlayDetail" Text="页面加载中，请稍候。" FontSize="15"
                           TextWrapping="Wrap" Foreground="{DynamicResource Ui.Muted}" Margin="0,0,0,22" />
                <Button x:Name="CourseRetryButton" Content="重试打开学习通" Height="40" MinWidth="180"
                        Visibility="Collapsed" Style="{StaticResource ToolbarButtonStyle}" Click="CourseRetry_Click" />
            </StackPanel>
        </Border>
        <Grid x:Name="HomeworkExplanationOverlay" Grid.Row="2" Grid.Column="2" Visibility="Collapsed"
              Background="#A62B2A2A">
            <Image x:Name="HomeworkExplanationBackdropImage" Stretch="UniformToFill"/>
            <Border Background="#AB242323"/>
            <Border x:Name="HomeworkExplanationBoard" Margin="18" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" Background="#FFFAFAF8" CornerRadius="24" Padding="28"
                    BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1">
                <Grid Width="Auto">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="HomeworkExplanationHeader_DoubleClick">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="详细解答" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Text="拖动左侧分隔线调整宽度 · 双击标题弹出独立窗口" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource Ui.Muted}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="34" Height="34" Content="×" FontSize="20"
                                ToolTip="关闭详解" Style="{StaticResource TaskTabButtonStyle}"
                                Click="HomeworkExplanationClose_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="980">
                            <TextBlock x:Name="HomeworkExplanationQuestion" TextWrapping="Wrap" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}" Margin="0,0,0,14"/>
                            <TextBlock x:Name="HomeworkExplanationAnswer" TextWrapping="Wrap" FontSize="15"
                                       Foreground="{DynamicResource Ui.Accent}" Margin="0,0,0,18"/>
                            <Border Height="1" Background="{DynamicResource Ui.Border}" Margin="0,0,0,20"/>
                            <TextBlock x:Name="HomeworkExplanationText" TextWrapping="Wrap" FontSize="16"
                                       FontFamily="{DynamicResource Ui.Font}" LineHeight="29"
                                       Foreground="{DynamicResource Ui.Text}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
