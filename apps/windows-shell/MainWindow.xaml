<Window x:Class="FaxToolbox.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Fax Toolbox" Width="1280" Height="800" MinWidth="780" MinHeight="560"
        Background="#F5F5F7" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="12,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="BorderBrush" Value="#DEDEE3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellColumn" Width="*" />
            <ColumnDefinition x:Name="SplitterColumn" Width="0" />
            <ColumnDefinition x:Name="WorkspaceColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <DockPanel x:Name="BrowserToolbar" Grid.Row="0" Grid.ColumnSpan="3" Visibility="Collapsed"
                   Background="#F5F5F7" LastChildFill="True">
            <Button x:Name="ToggleControlsButton" DockPanel.Dock="Right" Width="130" Margin="4"
                    Style="{StaticResource ToolbarButtonStyle}" Click="ToggleControls_Click" Content="展开学习页面" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,3,0,3">
                <StackPanel x:Name="TaskTabsPanel" Orientation="Horizontal" />
                <Button x:Name="NewTaskTabButton" Width="35" Height="35" Padding="0" Style="{StaticResource TaskTabButtonStyle}"
                        Click="NewTaskTab_Click" ToolTip="新建首页标签" Content="＋" />
            </StackPanel>
            <TextBlock x:Name="ToolbarTitle" Margin="14,0" VerticalAlignment="Center" Foreground="#6E6E73"
                       Text="关闭标签将结束该标签的任务" />
        </DockPanel>
        <wv2:WebView2 x:Name="ShellView" Grid.Row="1" Grid.Column="0" />
        <GridSplitter x:Name="WorkspaceSplitter" Grid.Row="1" Grid.Column="1" Width="6"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D2D2D7"
                      ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />
        <wv2:WebView2 x:Name="ModuleView" Grid.Row="1" Grid.Column="2" />
        <wv2:WebView2 x:Name="CourseView" Grid.Row="1" Grid.Column="2" Visibility="Collapsed" />
        <Border x:Name="CourseOverlay" Grid.Row="1" Grid.Column="2" Visibility="Collapsed"
                Background="#F5F5F7" Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock x:Name="CourseOverlayTitle" Text="正在打开学习通…" FontSize="24" FontWeight="SemiBold"
                           Foreground="#1D1D1F" Margin="0,0,0,12" />
                <TextBlock x:Name="CourseOverlayDetail" Text="页面加载中，请稍候。" FontSize="15"
                           TextWrapping="Wrap" Foreground="#6E6E73" Margin="0,0,0,22" />
                <Button x:Name="CourseRetryButton" Content="重试打开学习通" Height="40" MinWidth="180"
                        Visibility="Collapsed" Style="{StaticResource ToolbarButtonStyle}" Click="CourseRetry_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
