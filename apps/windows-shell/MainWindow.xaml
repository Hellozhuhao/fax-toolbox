<Window x:Class="FaxToolbox.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Fax Toolbox" Width="1280" Height="800" MinWidth="780" MinHeight="560"
        Background="#F5F5F7" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="12,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="BorderBrush" Value="#DEDEE3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellColumn" Width="*" />
            <ColumnDefinition x:Name="SplitterColumn" Width="0" />
            <ColumnDefinition x:Name="WorkspaceColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <DockPanel x:Name="BrowserToolbar" Grid.Row="0" Grid.ColumnSpan="3" Visibility="Collapsed"
                   Background="#F5F5F7" LastChildFill="True">
            <Button x:Name="ToggleControlsButton" DockPanel.Dock="Right" Width="130" Margin="4"
                    Style="{StaticResource ToolbarButtonStyle}" Click="ToggleControls_Click" Content="展开学习页面" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,3,0,3">
                <StackPanel x:Name="CourseTaskTab" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,5,0">
                    <Button x:Name="CourseTaskTabButton" MinWidth="124" Height="35" Style="{StaticResource TaskTabButtonStyle}"
                            Click="CourseTaskTab_Click" Content="学习通" />
                    <Button x:Name="CloseCourseTaskTabButton" Width="27" Height="35" Margin="2,0,0,0" Padding="0"
                            Style="{StaticResource TaskTabButtonStyle}" Click="CloseCourseTaskTab_Click"
                            ToolTip="关闭标签，任务继续运行" Content="×" />
                </StackPanel>
                <StackPanel x:Name="DemoTaskTab" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,5,0">
                    <Button x:Name="DemoTaskTabButton" MinWidth="124" Height="35" Style="{StaticResource TaskTabButtonStyle}"
                            Click="DemoTaskTab_Click" Content="页面演示" />
                    <Button x:Name="CloseDemoTaskTabButton" Width="27" Height="35" Margin="2,0,0,0" Padding="0"
                            Style="{StaticResource TaskTabButtonStyle}" Click="CloseDemoTaskTab_Click"
                            ToolTip="关闭标签，任务继续运行" Content="×" />
                </StackPanel>
                <Button x:Name="NewTaskTabButton" Width="35" Height="35" Padding="0" Style="{StaticResource TaskTabButtonStyle}"
                        Click="NewTaskTab_Click" ToolTip="新建任务标签" Content="＋">
                    <Button.ContextMenu><ContextMenu>
                        <MenuItem Header="学习通" Click="NewCourseTaskTab_Click" />
                        <MenuItem Header="页面事件演示" Click="NewDemoTaskTab_Click" />
                    </ContextMenu></Button.ContextMenu>
                </Button>
            </StackPanel>
            <TextBlock x:Name="ToolbarTitle" Margin="14,0" VerticalAlignment="Center" Foreground="#6E6E73"
                       Text="关闭标签不会结束任务" />
        </DockPanel>
        <wv2:WebView2 x:Name="ShellView" Grid.Row="1" Grid.Column="0" />
        <GridSplitter x:Name="WorkspaceSplitter" Grid.Row="1" Grid.Column="1" Width="6"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D2D2D7"
                      ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />
        <wv2:WebView2 x:Name="ModuleView" Grid.Row="1" Grid.Column="2" />
        <wv2:WebView2 x:Name="CourseView" Grid.Row="1" Grid.Column="2" Visibility="Collapsed" />
    </Grid>
</Window>
